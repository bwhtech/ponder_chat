{
	// The web app checked a second time, without the server. The API types in tsconfig.json
	// bring Node's globals (process, Buffer) into the check through the server's libraries,
	// so web code that uses them would pass there and fail in the browser. Here the server
	// is a stand-in (web/server-stub.d.ts) and Node's globals are errors again.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": { "#server/app": ["./web/server-stub.d.ts"] }
	}
}
