{
  "name": "ponder-chat",
  "version": "1.0.0",
  "description": "Ponder Chat: a chat app on OpenRouter models, with a daily credit limit per person.",
  "main": "index.js",
  "scripts": {
    "build": "vite build && nitro build",
    "typecheck": "node scripts/vue-tsc.cjs --noEmit -p tsconfig.json",
    "start": "./start.sh",
    "typecheck:server": "node node_modules/frappe-ui/node_modules/typescript/bin/tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --strict --skipLibCheck --allowImportingTsExtensions server/app.ts server/plugins/startup.ts",
    "sandbox:setup": "sandbox/pyodide/setup.sh",
    "build:web": "vite build",
    "build:server": "nitro build",
    "postinstall": "node scripts/patch-workflow-retries.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/provider": "^4.0.35",
    "@ai-sdk/vue": "^4.0.162",
    "@ai-sdk/workflow": "^2.0.94",
    "@hono/node-server": "^2.1.5",
    "@mozilla/readability": "^0.6.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@workflow/serde": "^4.1.0",
    "@workflow/world-postgres": "^5.1.1",
    "ai": "^7.0.162",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.12",
    "dompurify": "^3.4.17",
    "frappe-ui": "^1.0.2",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "linkedom": "^0.18.15",
    "marked": "^15.0.12",
    "nitro": "^3.0.261103-rc",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "rollup": "^4.67.5",
    "tsx": "^4.23.15",
    "undici": "^8.12.3",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "workflow": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  },
  "private": true
}
